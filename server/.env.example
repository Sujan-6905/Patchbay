# Port the Node/Express/Socket.IO server listens on.
PORT=5001

# development | production
NODE_ENV=development

# Origin(s) allowed to connect via CORS / Socket.IO: the deployed client origin(s) in
# production. Comma-separate multiple origins (e.g. a Vercel production domain plus its
# preview-deployment domain) if the client is hosted separately from this server.
CORS_ORIGIN=http://localhost:5173

# Minutes an empty, never-joined room is kept before the TTL sweep removes it.
ROOM_TTL_MINUTES=30

# Optional TURN relay (e.g. Open Relay Project free tier). Comma-separate multiple TURN_URLS.
# Leave unset to use STUN only (fine for most NATs; symmetric NAT needs TURN).
# TURN_URLS=turn:relay.example.com:80,turn:relay.example.com:443
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Groq API key used by the server to generate AI meeting summaries; the feature is free for
# users, powered by this one server-held key. Create one at https://console.groq.com/keys
# (the free tier is enough for personal use). Leave unset to disable summaries.
GROQ_API_KEY=

# Per-IP rate limit for POST /api/ai/summarize (protects the server-held Groq key's quota).
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=5

# Per-IP rate limit on the room:create socket event.
ROOM_CREATE_RATE_LIMIT_WINDOW_MS=60000
ROOM_CREATE_RATE_LIMIT_MAX=10

# Cap on a single Socket.IO signaling message (SDP/ICE only; media and file transfer never
# pass through this server). Generous headroom for a large SDP with many ICE candidates.
SOCKET_MAX_PAYLOAD_BYTES=131072
